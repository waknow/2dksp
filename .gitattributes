# Set default behavior to force Linux line endings:
* text eol=lf

# Force bash scripts to always use LF, so they work in Windows and Unix:
*.sh text eol=lf

# Denote all files that are truly binary and should not be modified:
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
